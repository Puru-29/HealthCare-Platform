# Copy to server/.env and adjust. Never commit the real .env.

PORT=3001
HOST=127.0.0.1

# SQLite file (created automatically). Use :memory: for throwaway runs.
DATABASE_PATH=./carepath.db

# Claude powers the care assistant. Without a key the assistant falls back to
# rule-based matching. Leave unset if you use `ant auth login` instead.
# ANTHROPIC_API_KEY=sk-ant-...

# Road routing for ETAs. The public OSRM demo server is fine for development only
# (no traffic data, fair-use limits). For production use a self-hosted OSRM or a
# traffic-aware provider such as Mappls or Google Routes.
ROUTING_URL=https://router.project-osrm.org
# Set to "off" to use straight-line estimates only (no network calls).
ROUTING_MODE=osrm

# How SOS alerts reach hospitals besides the live console:
#   console  - log only (development)
#   webhook  - POST each alert as JSON to NOTIFY_WEBHOOK_URL (wire this to an
#              Exotel/Twilio IVR flow: "press 1 to accept")
NOTIFY_MODE=console
NOTIFY_WEBHOOK_URL=

# Demo mode: `npm run seed -- --demo` creates console logins and simulated
# ambulances for a few real hospitals, and moves ambulances along the route
# when no driver phone is sharing location. Never enable in production.
DEMO_MODE=true
